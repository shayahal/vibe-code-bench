# =============================================================================
# Red Team Agent v3 Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration (REQUIRED - pick one)
# -----------------------------------------------------------------------------
# For LLM-guided intelligent testing, provide at least one API key:

# OpenAI (Recommended for GPT-4)
OPENAI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (Alternative)
# OPENROUTER_API_KEY=sk-or-...

# -----------------------------------------------------------------------------
# Observability (OPTIONAL)
# -----------------------------------------------------------------------------
# For Langfuse tracing and monitoring:


# -----------------------------------------------------------------------------
# Scan Configuration (OPTIONAL - can be set via code or interactive mode)
# -----------------------------------------------------------------------------

# Default scan depth: quick, standard, deep, comprehensive
# DEFAULT_SCAN_DEPTH=standard

# Default testing strategy: passive, active, aggressive
# DEFAULT_TESTING_STRATEGY=active

# Tool timeouts (seconds)
# SQLMAP_TIMEOUT=1800
# WAPITI_TIMEOUT=1200
# NUCLEI_TIMEOUT=600
# DALFOX_TIMEOUT=300

# SQLMap configuration
# SQLMAP_DEFAULT_LEVEL=5
# SQLMAP_DEFAULT_RISK=3

# Discovery configuration
# MAX_CRAWL_DEPTH=2
# MAX_URLS=50

# -----------------------------------------------------------------------------
# Agent Configuration (OPTIONAL)
# -----------------------------------------------------------------------------

# Enable/disable LLM orchestration (default: true if API key provided)
# USE_LLM_ORCHESTRATION=true

# LLM model selection (default: auto-detect based on API key)
# LLM_MODEL=gpt-4o
